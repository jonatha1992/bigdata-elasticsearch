nt="1"><mxGeometry x="960" y="70" width="180" height="65" as="geometry"/></mxCell><mxCell id="line4" style="dashed=1;endArrow=none;strokeColor=#8b9ba4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="135" as="sourcePoint"/><mxPoint x="1050" y="1620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5" value="Dashboard&#10;(proposed)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="1190" y="70" width="180" height="65" as="geometry"/></mxCell><mxCell id="line5" style="dashed=1;endArrow=none;strokeColor=#8b9ba4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="135" as="sourcePoint"/><mxPoint x="1280" y="1620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg0" value="Supply deterministic dataset configuration" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="190" as="sourcePoint"/><mxPoint x="360" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg1" value="Manifest, validation rejections and identical duplicates" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="268" as="sourcePoint"/><mxPoint x="1050" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg2" value="Valid unique records and expected totals" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="346" as="sourcePoint"/><mxPoint x="590" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg3" value="Bulk index: event_id as document ID" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="424" as="sourcePoint"/><mxPoint x="820" y="424" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg4" value="If transport/response lost: uncertain outcomes; bounded retries" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="502" as="sourcePoint"/><mxPoint x="685" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg5" value="Otherwise: per-item results" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="580" as="sourcePoint"/><mxPoint x="590" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg6" value="Classify each item, not just request status" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="658" as="sourcePoint"/><mxPoint x="685" y="686" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg7" value="LOOP: retry affected/uncertain items while budget permits" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="736" as="sourcePoint"/><mxPoint x="820" y="736" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg8" value="Per-item outcomes or transport failure" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="814" as="sourcePoint"/><mxPoint x="590" y="814" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg9" value="Final successes, permanent failures and exhausted retries" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="892" as="sourcePoint"/><mxPoint x="1050" y="892" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg10" value="If interrupted: mark incomplete and identify unresolved records" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="970" as="sourcePoint"/><mxPoint x="1050" y="970" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg11" value="If complete: establish search visibility; query totals" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="1048" as="sourcePoint"/><mxPoint x="820" y="1048" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg12" value="Searchable results" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1126" as="sourcePoint"/><mxPoint x="590" y="1126" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg13" value="Reconcile outcomes and independent expectations" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="1204" as="sourcePoint"/><mxPoint x="1050" y="1204" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg14" value="Open dataset time range and filters" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="1282" as="sourcePoint"/><mxPoint x="1280" y="1282" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg15" value="Query aggregates through Kibana" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="1360" as="sourcePoint"/><mxPoint x="820" y="1360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg16" value="Results for selected range" style="html=1;fontSize=11;endArrow=block;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1438" as="sourcePoint"/><mxPoint x="1280" y="1438" as="targetPoint"/></mxGeometry></mxCell><mxCell id="title" value="3. Proposed ingestion sequence and failure handling" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1250" height="40" as="geometry"/></mxCell><mxCell id="note" value="Proposed sequence. Conditional paths and retry loop are explicitly labelled. Stable IDs prevent multiplication on identical replay; dataset namespaces must prevent cross-dataset collisions. Retry limits, backoff and visibility mechanism remain to be selected." style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1650" width="1250" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="Event model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="4. Conceptual event model" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="event" value="Event&#10;event_id: string&#10;@timestamp: datetime&#10;event_type: string&#10;user_id: string&#10;session_id: string" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacing=12;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="240" height="170" as="geometry"/></mxCell><mxCell id="search" value="SearchPayload&#10;query: string&#10;results_count: integer" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacing=12;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="210" height="130" as="geometry"/></mxCell><mxCell id="view" value="ViewPayload&#10;product_id: string&#10;product_name: string&#10;category: string&#10;unit_price: number" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacing=12;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="400" width="210" height="170" as="geometry"/></mxCell><mxCell id="purchase" value="PurchasePayload&#10;unit_price: number&#10;quantity: integer&#10;amount: number" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacing=12;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="210" height="150" as="geometry"/></mxCell><mxCell id="error" value="ErrorPayload&#10;error_code: string&#10;severity: string&#10;message: string" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacing=12;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="210" height="150" as="geometry"/></mxCell><mxCell id="edge0" value="search only" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;labelBackgroundColor=#ffffff;fontSize=10;dashed=1;endArrow=open;" edge="1" parent="1" source="event" target="search"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" value="view only" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;labelBackgroundColor=#ffffff;fontSize=10;dashed=1;endArrow=open;" edge="1" parent="1" source="event" target="view"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="purchase only" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;labelBackgroundColor=#ffffff;fontSize=10;dashed=1;endArrow=open;" edge="1" parent="1" source="event" target="purchase"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="error only" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;labelBackgroundColor=#ffffff;fontSize=10;dashed=1;endArrow=open;" edge="1" parent="1" source="event" target="error"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Proposed logical contract, not an installed mapping. Exactly one matching payload per event. amount = unit_price × quantity. Currency and precision remain design decisions. Purchase product fields and order IDs are not required by current Python tests; do not infer order counts or product revenue." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1100" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
