ry"/></mxCell><mxCell id="note" value="Green: configured infrastructure, verified 2026-09-05. Orange dashed: proposed work. Docker was unreachable on 2026-09-06; this is not a live status view. Human login: elastic. Local-only HTTP. Services share the project Docker network. Named volumes survive container removal unless explicitly deleted." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1100" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="Data flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="2. Target data flow" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="config" value="Seed, count, start time,&#10;schema and currency" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="160" height="70" as="geometry"/></mxCell><mxCell id="gen" value="Python event generator" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="160" height="70" as="geometry"/></mxCell><mxCell id="val" value="Schema and duplicate&#10;validation" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="160" height="70" as="geometry"/></mxCell><mxCell id="invalid" value="Rejected records&#10;with reasons" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fff4df;strokeColor=#aa6b14;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="250" width="160" height="70" as="geometry"/></mxCell><mxCell id="load" value="Bounded bulk loader&#10